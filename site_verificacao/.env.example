# Discord OAuth2 (Developer Portal > OAuth2)
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=cole_o_client_secret_aqui
DISCORD_REDIRECT_URI=https://SEU-DOMINIO.vercel.app/api/verify/callback

# Bot (Developer Portal > Bot)
DISCORD_BOT_TOKEN=cole_o_token_do_bot_aqui
DISCORD_GUILD_ID=1287190286925303858
DISCORD_MINOR_ROLE_ID=000000000000000000
# Opcional: cargo para maiores de 18
DISCORD_ADULT_ROLE_ID=
# Canal onde o bot cria o convite de uso único após a verificação
DISCORD_INVITE_CHANNEL_ID=000000000000000000

# Assinatura do state (gere uma string aleatória longa)
VERIFY_SECRET=troque_por_uma_string_aleatoria_longa

# Google OAuth2 (Google Cloud Console > APIs e serviços > Credenciais)
# Ative a People API no projeto e peça o escopo user.birthday.read.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=cole_o_google_client_secret_aqui
GOOGLE_REDIRECT_URI=https://SEU-DOMINIO.vercel.app/api/verify/google-callback

# Supabase (Project Settings > API)
